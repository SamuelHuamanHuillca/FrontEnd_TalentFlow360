{
  "buildCommand": "ng build",
  "outputDirectory": "dist/frontend-talentflow360/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bakend-talentflow360.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
