{
  "buildCommand": "ng build",
  "outputDirectory": "dist/frontend-talentflow360/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bakend-talentflow360.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
